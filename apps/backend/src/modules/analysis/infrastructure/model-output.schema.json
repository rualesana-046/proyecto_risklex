        "additionalProperties": false
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": ["term", "explanation"],
        "additionalProperties": false
