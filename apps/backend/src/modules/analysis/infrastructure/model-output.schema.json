              },
              "required": ["type", "text"],
              "additionalProperties": false
            }
          },
          "profiles": {
            "type": "object",
            "properties": {
              "free_user": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string",
                    "enum": ["high_risk", "warning", "neutral"]
                  },
                  "meaning": {
                    "type": "string"
                  },
                  "consequence": {
                    "type": "string"
                  }
                },
                "required": ["severity", "meaning", "consequence"],
                "additionalProperties": false
              },
              "subscriber": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string",
                    "enum": ["high_risk", "warning", "neutral"]
                  },
                  "meaning": {
                    "type": "string"
                  },
                  "consequence": {
                    "type": "string"
                  }
                },
                "required": ["severity", "meaning", "consequence"],
                "additionalProperties": false
              },
              "professional": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string",
                    "enum": ["high_risk", "warning", "neutral"]
                  },
                  "meaning": {
                    "type": "string"
                  },
                  "consequence": {
                    "type": "string"
                  }
                },
                "required": ["severity", "meaning", "consequence"],
                "additionalProperties": false
              }
            },
            "required": ["free_user", "subscriber", "professional"],
            "additionalProperties": false
          }
        },
        "required": [
          "category",
          "title",
          "quote",
          "evidenceStatus",
          "isAmbiguous",
          "ambiguityReason",
          "confidence",
          "entities",
          "profiles"
