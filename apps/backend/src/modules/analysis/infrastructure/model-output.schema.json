{
  "type": "object",
  "properties": {
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": ["privacy", "tracking", "hidden_costs", "cancellation", "content_license"]
          },
          "title": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "evidenceStatus": {
